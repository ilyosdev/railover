# Railover Environment Variables Configuration
# Copy this file to .env and configure according to your needs

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Initial admin password for Railover dashboard
# IMPORTANT: Change this immediately after first login!
CAPTAIN_ADMIN_PASSWORD=changeme123

# Default email for SSL certificate notifications and system emails
CAPTAIN_DEFAULT_EMAIL=admin@railover.local

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Custom ports (optional - defaults shown below)
# CAPTAIN_HOST_HTTP_PORT=80
# CAPTAIN_HOST_HTTPS_PORT=443
# CAPTAIN_HOST_ADMIN_PORT=3000

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker socket path (usually doesn't need to be changed)
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# =============================================================================
# DATA DIRECTORY
# =============================================================================

# Base directory for Railover data
# All application data, configs, and SSL certificates are stored here
# CAPTAIN_BASE_DIRECTORY=/captain

# =============================================================================
# DEBUGGING (Development only)
# =============================================================================

# Enable debug mode (set to 1 for debug, 0 for production)
# CAPTAIN_IS_DEBUG=0

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Skip domain verification (not recommended for production)
# SKIP_VERIFYING_DOMAINS=false

# Enable Docker log timestamps
# ENABLE_DOCKER_LOGS_TIMESTAMP=true

# Docker API version
# DOCKER_API_VERSION=v1.44

# =============================================================================
# SSL CONFIGURATION
# =============================================================================

# Force HTTPS redirect for all apps (recommended for production)
# FORCE_HTTPS=true

# Let's Encrypt staging mode (for testing SSL setup)
# LETSENCRYPT_STAGING=false

# =============================================================================
# REGISTRY CONFIGURATION
# =============================================================================

# Internal Docker registry port
# REGISTRY_PORT=996

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Automatic backup schedule (cron format)
# AUTO_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention days
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# MONITORING
# =============================================================================

# Enable NetData monitoring
# ENABLE_NETDATA=true

# Enable GoAccess web analytics
# ENABLE_GOACCESS=true

# =============================================================================
# PERFORMANCE
# =============================================================================

# Maximum log size for apps
# DEFAULT_MAX_LOG_SIZE=512m

# Maximum build log entries
# BUILD_LOG_SIZE=50

# Maximum app log entries
# APP_LOG_SIZE=500

# Maximum version history to keep
# MAX_VERSION_HISTORY=50

# =============================================================================
# PROXY CONFIGURATION (if behind reverse proxy)
# =============================================================================

# Trust proxy headers
# TRUST_PROXY=false

# Proxy IP addresses to trust (comma-separated)
# TRUSTED_PROXIES=127.0.0.1,::1

# =============================================================================
# DATABASE CONFIGURATION (for Railover internal DB)
# =============================================================================

# Railover uses file-based storage by default
# No additional database configuration needed

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# You can override any configuration by creating:
# /opt/railover/data/config-override.json

# Example config-override.json:
# {
#   "defaultMaxLogSize": "1g",
#   "skipVerifyingDomains": false,
#   "defaultEmail": "admin@example.com"
# }
